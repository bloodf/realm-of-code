{
  "name": "realm-of-code",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "description": "A medieval RPG that teaches programming from zero to hero.",
  "scripts": {
    "vendor": "node scripts/build-vendor.mjs",
    "dev": "npm run vendor && vite",
    "build": "npm run vendor && tsc -b && vite build",
    "preview": "vite preview",
    "export-assets": "node scripts/export-assets.ts",
    "verify-lessons": "node tests/verify-lessons.cjs",
    "verify-farm": "node scripts/verify-farm.ts",
    "i18n": "node scripts/i18n.cjs build",
    "i18n:extract": "node scripts/i18n.cjs extract",
    "typecheck": "tsc -b && tsc -p tests/unit",
    "test": "npm run typecheck && npm run i18n:check && npm run test:unit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && node tests/e2e.cjs",
    "test:e2e:quick": "npm run build && node tests/e2e.cjs --quick",
    "test:all": "npm test && npm run test:e2e",
    "i18n:check": "node scripts/i18n.cjs check"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/jacquard-12": "^5.3.0",
    "@fontsource/jersey-15": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@replit/codemirror-lang-svelte": "^6.0.0",
    "@tailwindcss/browser": "^4.3.3",
    "@vue/compiler-sfc": "^3.5.45",
    "acorn": "^8.19.0",
    "blockly": "^13.3.0",
    "codemirror": "^6.0.2",
    "phaser": "^3.90.0",
    "php-wasm": "^0.1.0",
    "pyodide": "^0.29.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "^1.16.0",
    "sucrase": "^3.35.1",
    "svelte": "^5.57.3",
    "typescript": "^5.9.3",
    "vue": "^3.5.45",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/sql.js": "^1.4.11",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
